---
/**
 * Palette picker (remarque-tokens/deck + chrome, 0.31): the reader's choice
 * of color theme. The site's own palette stays the default (value=""). Options
 * come from the deck manifest; swatches come from deck.css (and the site's own
 * from tokens-site.css). Native radios, so keyboard operation needs no script.
 */
import manifest from 'remarque-tokens/deck.json';

const palettes: { name: string; label: string }[] = manifest.palettes;
---

<details class="remarque-deck-picker remarque-deck-picker--popover" id="palette-picker">
  {/* Header icon button beside the theme toggle (remarque-tokens 0.32's
      popover variant): the footer placement went unnoticed. */}
  <summary class="palette-toggle" aria-label="Color theme" title="Color theme">
    <svg class="palette-icon" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4.098 19.902a3.75 3.75 0 0 0 5.304 0l6.401-6.402M6.75 21A3.75 3.75 0 0 1 3 17.25V4.125C3 3.504 3.504 3 4.125 3h5.25c.621 0 1.125.504 1.125 1.125v4.072M6.75 21a3.75 3.75 0 0 0 3.75-3.75V8.197M6.75 21h13.125c.621 0 1.125-.504 1.125-1.125v-5.25c0-.621-.504-1.125-1.125-1.125h-4.072M10.5 8.197l2.88-2.88c.438-.439 1.15-.439 1.59 0l3.712 3.713c.44.44.44 1.152 0 1.59l-2.879 2.88M6.75 17.25h.008v.008H6.75v-.008Z" />
    </svg>
    <span class="remarque-sr-only" data-deck-current>Tsundoku</span>
  </summary>
  <fieldset>
    <legend class="remarque-sr-only">Color theme</legend>
    <label class="remarque-deck-option">
      <input type="radio" name="remarque-palette" value="" checked />
      <span class="remarque-deck-swatches" data-palette-swatch="default" aria-hidden="true"><span></span><span></span><span></span></span>
      Tsundoku
    </label>
    {palettes.map((p) => (
      <label class="remarque-deck-option">
        <input type="radio" name="remarque-palette" value={p.name} />
        <span class="remarque-deck-swatches" data-palette-swatch={p.name} aria-hidden="true"><span></span><span></span><span></span></span>
        {p.label}
      </label>
    ))}
  </fieldset>
</details>

<script define:vars={{ labels: Object.fromEntries(palettes.map((p) => [p.name, p.label])) }}>
  window.__remarqueDeckLabels = labels;
</script>
<script>
  import { createDeck, bindPicker } from 'remarque-tokens/deck';
  import manifest from 'remarque-tokens/deck.json';

  // The header is re-rendered on every client-side navigation, so bind on
  // each astro:page-load (module scripts run once).
  function init() {
    const picker = document.getElementById('palette-picker');
    if (!picker) return;
    const labels: Record<string, string> = (window as any).__remarqueDeckLabels ?? {};
    const current = picker.querySelector('[data-deck-current]');
    const deck = createDeck(manifest.palettes.map((p: { name: string }) => p.name));
    deck.restore();
    bindPicker(deck, picker, {
      onChange: (name) => { if (current) current.textContent = name ? (labels[name] ?? name) : 'Tsundoku'; },
    });
  }
  document.addEventListener('astro:page-load', init);

  // Popover manners, registered once (not per navigation): Escape closes
  // the panel and returns focus to its button; so does a click outside.
  const openPicker = () => document.querySelector<HTMLDetailsElement>('#palette-picker[open]');
  document.addEventListener('keydown', (e) => {
    const p = openPicker();
    if (e.key === 'Escape' && p) {
      p.open = false;
      p.querySelector('summary')?.focus();
    }
  });
  document.addEventListener('click', (e) => {
    const p = openPicker();
    if (p && !p.contains(e.target as Node)) p.open = false;
  });
</script>

<style>
  /* Same 44px icon button as ThemeToggle.svelte and the mobile menu toggle. */
  .palette-toggle {
    min-width: 2.75rem;
    min-height: 2.75rem;
    color: var(--text-muted);
    transition: color var(--motion-normal, 180ms) ease;
  }
  .palette-toggle:hover,
  #palette-picker[open] .palette-toggle {
    color: var(--text);
  }
  .palette-icon {
    width: 1.25rem;
    height: 1.25rem;
  }
</style>
